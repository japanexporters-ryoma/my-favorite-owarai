{
  "name": "my-favorite-owarai",
  "version": "1.0.0",
  "description": "寝たきりのお父様のためのYouTubeお笑い動画カードシアターアプリ",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "cd client && npm install --include=dev && npm run build",
    "dev:server": "node server.js",
    "dev:client": "cd client && npm run dev",
    "postinstall": "cd client && npm install --include=dev"
  },
  "keywords": [
    "owarai",
    "care",
    "youtube",
    "senior",
    "theater"
  ],
  "author": "Ryoma Yamanao",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "yt-search": "^2.12.1"
  }
}
